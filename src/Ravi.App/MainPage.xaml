<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Ravi.App.MainPage" BackgroundColor="#FFF9EF" Shell.NavBarIsVisible="False">
 <ContentPage.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="BackgroundColor" Value="White"/><Setter Property="Stroke" Value="#EDE4D4"/><Setter Property="StrokeShape" Value="RoundRectangle 26"/><Setter Property="Padding" Value="22"/><Setter Property="Shadow"><Shadow Brush="#1B315F" Opacity="0.08" Radius="18" Offset="0,7"/></Setter></Style>
  <Style x:Key="Primary" TargetType="Button"><Setter Property="BackgroundColor" Value="#FF6B35"/><Setter Property="TextColor" Value="White"/><Setter Property="CornerRadius" Value="18"/><Setter Property="HeightRequest" Value="58"/><Setter Property="FontAttributes" Value="Bold"/><Setter Property="FontSize" Value="16"/></Style>
  <Style x:Key="Ghost" TargetType="Button"><Setter Property="BackgroundColor" Value="#EDF8F7"/><Setter Property="TextColor" Value="#087F83"/><Setter Property="CornerRadius" Value="18"/><Setter Property="HeightRequest" Value="54"/><Setter Property="FontAttributes" Value="Bold"/></Style>
 </ContentPage.Resources>
 <Grid RowDefinitions="Auto,*">
  <Grid Padding="24,18" BackgroundColor="#152C55" ColumnDefinitions="Auto,*,Auto">
   <Button Text="‹" Command="{Binding BackCommand}" IsVisible="{Binding ShowBack}" BackgroundColor="Transparent" TextColor="White" FontSize="28" WidthRequest="38"/>
   <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="9"><Label Text="RAVI" TextColor="White" FontSize="21" FontAttributes="Bold" CharacterSpacing="2"/><Border BackgroundColor="#20B8B2" StrokeThickness="0" StrokeShape="RoundRectangle 9" Padding="8,3"><Label Text="ENGLISH" TextColor="White" FontSize="9" FontAttributes="Bold"/></Border></HorizontalStackLayout>
   <Border Grid.Column="2" BackgroundColor="#263F6A" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="11,7"><Label Text="{Binding StudentBadge}" TextColor="White" FontAttributes="Bold"/></Border>
  </Grid>
  <ScrollView Grid.Row="1"><VerticalStackLayout Padding="24,26,24,50" Spacing="20" MaximumWidthRequest="760" HorizontalOptions="Center">
   <Grid IsVisible="{Binding IsLogin}" RowDefinitions="Auto,Auto,Auto" RowSpacing="20">
    <Grid ColumnDefinitions="*,150"><VerticalStackLayout VerticalOptions="Center" Spacing="8"><Label Text="سلام! Bereit für dein Abenteuer?" TextColor="#152C55" FontSize="31" FontAttributes="Bold"/><Label Text="Lerne Englisch mit Ravi – mit Geschichten, Spielen und echten Erfolgen." TextColor="#65738A" FontSize="16" LineHeight="1.35"/></VerticalStackLayout><Border Grid.Column="1" BackgroundColor="#FFE4CA" StrokeThickness="0" StrokeShape="RoundRectangle 34" Padding="8"><Image x:Name="RaviMascot" Source="ravi_guide_v2.png" Aspect="AspectFit" HeightRequest="140"/></Border></Grid>
    <VerticalStackLayout Grid.Row="1" Spacing="7"><Label Text="WER BIST DU?" TextColor="#19A8A5" FontSize="12" FontAttributes="Bold" CharacterSpacing="1.8"/><Label Text="Wähle deinen Zugang" TextColor="#152C55" FontSize="25" FontAttributes="Bold"/></VerticalStackLayout>
    <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto" RowSpacing="12"><Button Text="🎒  Ich bin Schüler/in" Command="{Binding SelectRoleCommand}" CommandParameter="Student" Style="{StaticResource Primary}"/><Button Grid.Row="1" Text="✦  Ich bin Lehrer/in  ·  Demnächst" Style="{StaticResource Ghost}"/><Button Grid.Row="2" Text="♥  Ich bin ein Elternteil  ·  Demnächst" Style="{StaticResource Ghost}"/></Grid>
   </Grid>
   <VerticalStackLayout IsVisible="{Binding IsProfile}" Spacing="18">
    <Grid ColumnDefinitions="*,110"><VerticalStackLayout VerticalOptions="Center" Spacing="6"><Label Text="DEIN PROFIL" TextColor="#19A8A5" FontSize="12" FontAttributes="Bold" CharacterSpacing="1.8"/><Label Text="Ravi möchte dich kennenlernen" TextColor="#152C55" FontSize="29" FontAttributes="Bold"/><Label Text="Deine Angaben machen Geschichten und Aufgaben persönlich." TextColor="#65738A" FontSize="15"/></VerticalStackLayout><Image x:Name="RaviProfile" Grid.Column="1" Source="ravi_guide_v2.png" HeightRequest="125" Aspect="AspectFit"><Image.GestureRecognizers><TapGestureRecognizer Tapped="RaviTapped"/></Image.GestureRecognizers></Image></Grid>
    <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="14">
     <Label Text="Wie heißt du?" TextColor="#152C55" FontAttributes="Bold"/>
     <Entry Text="{Binding StudentName}" Placeholder="Dein Vorname oder Rufname" BackgroundColor="#F6F8F7" TextColor="#152C55" HeightRequest="54"/>
     <Label Text="Wie alt bist du?" TextColor="#152C55" FontAttributes="Bold"/>
     <Entry Text="{Binding AgeText}" Placeholder="Zum Beispiel: 13" Keyboard="Numeric" MaxLength="2" BackgroundColor="#F6F8F7" TextColor="#152C55" HeightRequest="54"/>
     <Label Text="Wähle aus" TextColor="#152C55" FontAttributes="Bold"/>
     <Grid ColumnDefinitions="*,*" ColumnSpacing="10"><Button Text="👧  Mädchen" Command="{Binding SelectGenderCommand}" CommandParameter="Girl" BackgroundColor="{Binding GirlButtonColor}" TextColor="{Binding GirlTextColor}" CornerRadius="16" HeightRequest="54"/><Button Grid.Column="1" Text="👦  Junge" Command="{Binding SelectGenderCommand}" CommandParameter="Boy" BackgroundColor="{Binding BoyButtonColor}" TextColor="{Binding BoyTextColor}" CornerRadius="16" HeightRequest="54"/></Grid>
     <Label Text="{Binding ProfileError}" IsVisible="{Binding HasProfileError}" TextColor="#C34040" FontAttributes="Bold"/>
    </VerticalStackLayout></Border>
    <Button Text="Mein Abenteuer starten  →" Command="{Binding CreateProfileCommand}" Style="{StaticResource Primary}"/>
    <Label Text="Ravi verwendet diese Angaben nur, um deinen Lernweg persönlich zu gestalten." TextColor="#7D8797" FontSize="11" HorizontalTextAlignment="Center"/>
   </VerticalStackLayout>
   <VerticalStackLayout IsVisible="{Binding IsGrades}" Spacing="18"><Label Text="DEIN LERNWEG" TextColor="#19A8A5" FontSize="13" FontAttributes="Bold" CharacterSpacing="1.5"/><Label Text="In welcher Klasse bist du?" TextColor="#152C55" FontSize="30" FontAttributes="Bold"/><Label Text="Ravi passt Wörter, Texte und Übungen an deine Stufe an." TextColor="#65738A" FontSize="16"/>
    <FlexLayout BindableLayout.ItemsSource="{Binding Grades}" Wrap="Wrap" JustifyContent="SpaceBetween"><BindableLayout.ItemTemplate><DataTemplate><Button Text="{Binding StringFormat='Klasse {0}'}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectGradeCommand}" CommandParameter="{Binding .}" BackgroundColor="White" TextColor="#152C55" BorderColor="#D9E4E4" BorderWidth="1" CornerRadius="22" WidthRequest="155" HeightRequest="92" FontSize="18" FontAttributes="Bold" Margin="0,6"/></DataTemplate></BindableLayout.ItemTemplate></FlexLayout>
   </VerticalStackLayout>
   <VerticalStackLayout IsVisible="{Binding IsLessons}" Spacing="16">
    <Grid ColumnDefinitions="*,110"><VerticalStackLayout Spacing="5"><Label Text="DEIN KURS" TextColor="#19A8A5" FontAttributes="Bold" CharacterSpacing="1.5" FontSize="12"/><Label Text="{Binding WelcomeTitle}" TextColor="#152C55" FontSize="31" FontAttributes="Bold"/><Label Text="{Binding GradeTitle}" TextColor="#19A8A5" FontAttributes="Bold"/><Label Text="{Binding WelcomeSubtitle}" TextColor="#65738A"/></VerticalStackLayout><Image x:Name="RaviCourse" Grid.Column="1" Source="ravi_guide_v2.png" HeightRequest="125" Aspect="AspectFit"><Image.GestureRecognizers><TapGestureRecognizer Tapped="RaviTapped"/></Image.GestureRecognizers></Image></Grid>
    <Border Style="{StaticResource Card}" BackgroundColor="#152C55" StrokeThickness="0"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="7"><Label Text="DEIN FORTSCHRITT" TextColor="#63D7D1" FontSize="11" FontAttributes="Bold"/><Label Text="{Binding CourseProgressLabel}" TextColor="White" FontSize="22" FontAttributes="Bold"/><ProgressBar Progress="0" ProgressColor="#FF8A4C" BackgroundColor="#30466D"/></VerticalStackLayout><Label Grid.Column="1" Text="0%" TextColor="White" FontSize="24" FontAttributes="Bold" VerticalOptions="Center"/></Grid></Border>
    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lessons}" Spacing="12"><BindableLayout.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenLessonCommand}" CommandParameter="{Binding .}"/></Border.GestureRecognizers><Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="14"><Border BackgroundColor="#FFF0E3" StrokeThickness="0" StrokeShape="RoundRectangle 18" HeightRequest="54" WidthRequest="54"><Label Text="{Binding Number}" TextColor="#FF6B35" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border><VerticalStackLayout Grid.Column="1" Spacing="3"><Label Text="{Binding Title}" TextColor="#152C55" FontSize="18" FontAttributes="Bold"/><Label Text="{Binding Meta}" TextColor="#738096" FontSize="12"/></VerticalStackLayout><Label Grid.Column="2" Text="{Binding Duration}" TextColor="#19A8A5" VerticalOptions="Center" FontAttributes="Bold"/></Grid></Border></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
   </VerticalStackLayout>
   <VerticalStackLayout IsVisible="{Binding IsLearning}" Spacing="17">
    <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding StepEyebrow}" TextColor="#19A8A5" FontSize="12" FontAttributes="Bold" CharacterSpacing="1.5"/><Label Text="{Binding ProgressLabel}" TextColor="#758197" FontSize="12"/></VerticalStackLayout><Label Grid.Column="1" Text="🔥 +10 XP" TextColor="#FF6B35" FontAttributes="Bold"/></Grid>
    <ProgressBar Progress="{Binding LessonProgress}" ProgressColor="#19A8A5" BackgroundColor="#E3ECEA" HeightRequest="8"/>
    <Grid ColumnDefinitions="*,120"><Label Text="{Binding StepTitle}" TextColor="#152C55" FontSize="30" FontAttributes="Bold" VerticalOptions="Center"/><Image x:Name="RaviLesson" Grid.Column="1" Source="ravi_guide_v2.png" HeightRequest="140" Aspect="AspectFit"><Image.GestureRecognizers><TapGestureRecognizer Tapped="RaviTapped"/></Image.GestureRecognizers></Image></Grid>
    <Border Style="{StaticResource Card}" BackgroundColor="#FFF3E5" Stroke="#FFD2AD"><VerticalStackLayout Spacing="16"><Label Text="{Binding StepContent}" TextColor="#233A5E" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center" LineHeight="1.35"/><Button Text="🔊  English anhören" Clicked="SpeakClicked" Style="{StaticResource Ghost}"/><Button Text="{Binding StepTranslation}" Command="{Binding ToggleTranslationCommand}" BackgroundColor="Transparent" TextColor="#A24C27" FontSize="16"/></VerticalStackLayout></Border>
    <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="12"><Label Text="Jetzt du" TextColor="#152C55" FontAttributes="Bold"/><Label Text="{Binding AnswerPrompt}" TextColor="#65738A"/><Entry Text="{Binding Answer}" Placeholder="Antwort eingeben …" BackgroundColor="#F6F8F7" TextColor="#152C55" HeightRequest="54"/><Button Text="Antwort prüfen" Command="{Binding CheckCommand}" Style="{StaticResource Ghost}"/><Label Text="{Binding Feedback}" IsVisible="{Binding HasFeedback}" TextColor="#087F83" FontAttributes="Bold" HorizontalTextAlignment="Center"/></VerticalStackLayout></Border>
    <Button Text="{Binding NextLabel}" Command="{Binding NextCommand}" Style="{StaticResource Primary}"/>
   </VerticalStackLayout>
  </VerticalStackLayout></ScrollView>
 </Grid>
</ContentPage>
