<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ravi.App.MainPage"
             BackgroundColor="#11161B"
             Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#D9262C33" />
            <Setter Property="Stroke" Value="#35FFFFFF" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 24" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Shadow">
                <Shadow Brush="#111820" Opacity="0.13" Radius="24" Offset="0,10" />
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#F0522D" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="27" />
            <Setter Property="HeightRequest" Value="54" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="Secondary" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#CC30373F" />
            <Setter Property="TextColor" Value="#F3F4F5" />
            <Setter Property="BorderColor" Value="#35FFFFFF" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="25" />
            <Setter Property="HeightRequest" Value="50" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="Label">
            <Setter Property="TextColor" Value="#F0522D" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="1.6" />
        </Style>
        <Style x:Key="Field" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="#CC30373F" />
            <Setter Property="TextColor" Value="#F3F4F5" />
            <Setter Property="PlaceholderColor" Value="#7A8188" />
            <Setter Property="HeightRequest" Value="58" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <Image x:Name="StageBackdrop" Grid.RowSpan="2" Aspect="AspectFill" Opacity="0.94" />
        <BoxView Grid.RowSpan="2" Color="#55090D12" />
        <Grid IsVisible="{Binding ShowBack}" Padding="24,13" BackgroundColor="#CC171C22" ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
            <Button Text="‹" Command="{Binding BackCommand}" IsVisible="{Binding ShowBack}"
                    BackgroundColor="Transparent" TextColor="#F3F4F5" FontSize="29" Padding="0" />
            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="10">
                <Border BackgroundColor="#F7F7F7" Stroke="#80FFFFFF" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="4" HeightRequest="44" WidthRequest="44">
                    <Image Source="ravi_logo.png" Aspect="AspectFit" />
                </Border>
                <VerticalStackLayout Spacing="-2" VerticalOptions="Center">
                    <Label Text="RAVI" TextColor="#F3F4F5" FontSize="20" FontAttributes="Bold" CharacterSpacing="2" />
                    <Label Text="ENGLISH ADVENTURE" TextColor="#BBC2C9" FontSize="8" CharacterSpacing="1.2" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
            <Border Grid.Column="2" BackgroundColor="#CC30373F" Stroke="#35FFFFFF" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="14,8">
                <Label Text="{Binding StudentBadge}" TextColor="#F3F4F5" FontSize="12" FontAttributes="Bold" />
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="PageContent" Spacing="22" HorizontalOptions="Fill">

                <!-- Start -->
                <Grid x:Name="StartHero" IsVisible="{Binding IsLogin}" MinimumHeightRequest="680">
                    <Image x:Name="RaviMascot" Aspect="AspectFill" />
                    <BoxView Color="#30070B10" />

                    <Grid Padding="34,26" RowDefinitions="Auto,*,Auto">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border BackgroundColor="#F7F7F7" Stroke="#80FFFFFF" StrokeThickness="1" StrokeShape="RoundRectangle 15" Padding="5" HeightRequest="48" WidthRequest="48"><Image Source="ravi_logo.png" Aspect="AspectFit" /></Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="-3" VerticalOptions="Center"><Label Text="RAVI" TextColor="White" FontSize="21" FontAttributes="Bold" CharacterSpacing="2" /><Label Text="ENGLISH ADVENTURE" TextColor="#BBC2C9" FontSize="8" CharacterSpacing="1.2" /></VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="2" Spacing="24" VerticalOptions="Center"><Label Text="LEARN" TextColor="#E8EAEC" FontSize="11" FontAttributes="Bold" CharacterSpacing="1.5" /><Label Text="STORIES" TextColor="#E8EAEC" FontSize="11" FontAttributes="Bold" CharacterSpacing="1.5" /><Label Text="EN · FA" TextColor="#F0522D" FontSize="11" FontAttributes="Bold" CharacterSpacing="1.5" /></HorizontalStackLayout>
                        </Grid>

                        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Start" Spacing="12" MaximumWidthRequest="390">
                            <Label Text="LEARN ENGLISH WITH YOUR OWN GUIDE" TextColor="#F0522D" FontSize="11" FontAttributes="Bold" CharacterSpacing="1.8" />
                            <Label Text="A new world begins with one word." TextColor="White" FontSize="48" FontAttributes="Bold" LineHeight="0.98" />
                        </VerticalStackLayout>

                        <Grid Grid.Row="2" ColumnDefinitions="1.1*,0.9*" ColumnSpacing="20">
                            <Border BackgroundColor="#E6252B32" Stroke="#30FFFFFF" StrokeThickness="1" StrokeShape="RoundRectangle 28" Padding="26,20">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                    <VerticalStackLayout Spacing="7"><Label Text="YOUR ENGLISH ADVENTURE" TextColor="#F0522D" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.5" /><Label Text="Vocabulary, stories, grammar and speaking — guided by Ravi." TextColor="White" FontSize="17" FontAttributes="Bold" LineHeight="1.25" /><Label Text="واژه، داستان و تمرین؛ قدم‌به‌قدم با راوی" FlowDirection="RightToLeft" TextColor="#C9CDD1" FontSize="14" HorizontalTextAlignment="End" /></VerticalStackLayout>
                                    <Button Grid.Column="1" Text="START  →" Command="{Binding SelectRoleCommand}" CommandParameter="Student" Style="{StaticResource Primary}" WidthRequest="150" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="#C2262C33" Stroke="#70FFFFFF" StrokeThickness="1" StrokeShape="RoundRectangle 28" Padding="24,18">
                                <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="4"><Label Text="01 / YOUR JOURNEY" TextColor="#F0522D" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.3" /><Label Text="Listen · Read · Speak" TextColor="#F3F4F5" FontSize="17" FontAttributes="Bold" /></VerticalStackLayout><Label Grid.Column="1" Text="↓" TextColor="#F3F4F5" FontSize="25" VerticalOptions="Center" /></Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Profile -->
                <Grid x:Name="ProfileStage" IsVisible="{Binding IsProfile}" MinimumHeightRequest="680" Margin="36,18,36,50" MaximumWidthRequest="1180" HorizontalOptions="Fill">
                    <Grid ColumnDefinitions="1.05*,0.95*" ColumnSpacing="20">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="18" MaximumWidthRequest="520">
                            <Border BackgroundColor="#C2262C33" Stroke="#70FFFFFF" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="14,8" HorizontalOptions="Start">
                                <Label Text="CREATE YOUR LEARNING ID" Style="{StaticResource SectionLabel}" FontSize="10" />
                            </Border>
                            <Label Text="Let Ravi get to know you." TextColor="#F3F4F5" FontSize="44" FontAttributes="Bold" LineHeight="1" />
                            <Label Text="Your details shape the stories, exercises and learning path Ravi prepares for you." TextColor="#BBC2C9" FontSize="16" LineHeight="1.35" />
                            <Border Style="{StaticResource Card}" Padding="26">
                                <VerticalStackLayout Spacing="11">
                                    <Label Text="YOUR NAME" TextColor="#B5BCC3" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.4" />
                                    <Entry Text="{Binding StudentName}" Placeholder="First name or nickname" Style="{StaticResource Field}" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="7">
                                            <Label Text="YOUR AGE" TextColor="#B5BCC3" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.4" />
                                            <Entry Text="{Binding AgeText}" Placeholder="For example: 13" Keyboard="Numeric" MaxLength="2" Style="{StaticResource Field}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="7">
                                            <Label Text="CHOOSE ONE" TextColor="#B5BCC3" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.4" />
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                <Button Text="Girl" Command="{Binding SelectGenderCommand}" CommandParameter="Girl" BackgroundColor="{Binding GirlButtonColor}" TextColor="{Binding GirlTextColor}" BorderColor="#80FFFFFF" BorderWidth="1" CornerRadius="25" HeightRequest="58" />
                                                <Button Grid.Column="1" Text="Boy" Command="{Binding SelectGenderCommand}" CommandParameter="Boy" BackgroundColor="{Binding BoyButtonColor}" TextColor="{Binding BoyTextColor}" BorderColor="#80FFFFFF" BorderWidth="1" CornerRadius="25" HeightRequest="58" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Label Text="{Binding ProfileError}" IsVisible="{Binding HasProfileError}" TextColor="#C34040" FontAttributes="Bold" />
                                    <Button Text="Start my adventure     →" Command="{Binding CreateProfileCommand}" Style="{StaticResource Primary}" Margin="0,6,0,0" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                        <Grid Grid.Column="1">
                            <Image x:Name="RaviProfile" HeightRequest="610" Aspect="AspectFit" VerticalOptions="End">
                                <Image.GestureRecognizers><TapGestureRecognizer Tapped="RaviTapped" /></Image.GestureRecognizers>
                            </Image>
                            <Border BackgroundColor="#B5262C33" Stroke="#70FFFFFF" StrokeThickness="1" StrokeShape="RoundRectangle 25" Padding="20,14" HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,8,100">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="RAVI SAYS" TextColor="#F0522D" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.4" />
                                    <Label Text="This will only take a moment." TextColor="#F3F4F5" FontSize="15" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Grades -->
                <Grid x:Name="GradesStage" IsVisible="{Binding IsGrades}" MinimumHeightRequest="680" Margin="36,18,36,50" MaximumWidthRequest="1180" HorizontalOptions="Fill">
                    <Grid ColumnDefinitions="1.35*,0.65*" ColumnSpacing="24">
                    <VerticalStackLayout Spacing="18" VerticalOptions="Center">
                    <Border BackgroundColor="#C91E242B" Stroke="#70FFFFFF" StrokeThickness="1" StrokeShape="RoundRectangle 30" Padding="32,24">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="CHOOSE YOUR PATH" TextColor="#F0522D" FontSize="11" FontAttributes="Bold" CharacterSpacing="1.5" />
                                <Label Text="Which grade are you in?" TextColor="#F3F4F5" FontSize="34" FontAttributes="Bold" />
                                <Label Text="پایه خود را انتخاب کن تا راوی مسیر مناسب را باز کند." FlowDirection="RightToLeft" TextColor="#B5BCC3" FontSize="16" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                    </Border>
                    <FlexLayout BindableLayout.ItemsSource="{Binding Grades}" Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Start">
                        <BindableLayout.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="22" WidthRequest="280" Margin="0,7">
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectGradeCommand}" CommandParameter="{Binding Number}" /></Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="12">
                                        <Border BackgroundColor="#252B32" StrokeThickness="0" StrokeShape="RoundRectangle 15" HeightRequest="48" WidthRequest="48">
                                            <Label Text="{Binding Number, StringFormat='{0:00}'}" TextColor="White" FontSize="17" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        </Border>
                                        <Label Grid.Column="1" Text="LEARNING PATH" TextColor="#708094" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.2" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="{Binding PersianName}" FlowDirection="RightToLeft" TextColor="#0E7C7B" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                                    </Grid>
                                    <Label Text="{Binding Number, StringFormat='Grade {0}'}" TextColor="#F3F4F5" FontSize="25" FontAttributes="Bold" />
                                    <Label Text="{Binding Subtitle}" TextColor="#AEB6BF" FontSize="13" />
                                    <BoxView HeightRequest="1" Color="#E7EBF0" />
                                    <Grid ColumnDefinitions="*,Auto"><Label Text="Select grade" TextColor="#F3F4F5" FontAttributes="Bold" FontSize="13" /><Border Grid.Column="1" BackgroundColor="#F0522D" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="11,5"><Label Text="→" TextColor="White" FontSize="17" /></Border></Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate></BindableLayout.ItemTemplate>
                    </FlexLayout>
                    </VerticalStackLayout>
                    <Grid Grid.Column="1">
                        <Image x:Name="RaviGrades" Aspect="AspectFill" />
                        <BoxView Color="#33090D12" />
                        <Border BackgroundColor="#B5262C33" Stroke="#70FFFFFF" StrokeThickness="1" StrokeShape="RoundRectangle 25" Padding="20,14" HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,0,100">
                            <VerticalStackLayout Spacing="3"><Label Text="YOUR PATH" TextColor="#F0522D" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.4" /><Label Text="Choose your grade." TextColor="#F3F4F5" FontSize="15" FontAttributes="Bold" /></VerticalStackLayout>
                        </Border>
                    </Grid>
                    </Grid>
                </Grid>

                <!-- Lessons -->
                <Grid x:Name="LessonsStage" IsVisible="{Binding IsLessons}" MinimumHeightRequest="680" Margin="36,18,36,50" MaximumWidthRequest="1180" HorizontalOptions="Fill">
                    <Grid ColumnDefinitions="1.35*,0.65*" ColumnSpacing="24">
                    <VerticalStackLayout Spacing="16" VerticalOptions="Center">
                    <Border BackgroundColor="#C91E242B" Stroke="#70FFFFFF" StrokeThickness="1" StrokeShape="RoundRectangle 30" Padding="30,20">
                    <Grid>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="YOUR COURSE" Style="{StaticResource SectionLabel}" />
                            <Label Text="{Binding WelcomeTitle}" TextColor="#F3F4F5" FontSize="34" FontAttributes="Bold" />
                            <Label Text="{Binding GradeTitle}" TextColor="#F0522D" FontAttributes="Bold" />
                            <Label Text="{Binding WelcomeSubtitle}" TextColor="#AEB6BF" />
                        </VerticalStackLayout>
                    </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" BackgroundColor="#252B32" StrokeThickness="0">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="YOUR ADVENTURE MAP" TextColor="#F0522D" FontSize="11" FontAttributes="Bold" CharacterSpacing="1.4" />
                                <Label Text="{Binding CourseProgressLabel}" TextColor="White" FontSize="21" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="PATH" TextColor="#F0522D" FontSize="11" FontAttributes="Bold" CharacterSpacing="1.4" VerticalOptions="Center" />
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Progress="0" ProgressColor="#F0522D" BackgroundColor="#4B5158" HeightRequest="8" Margin="0,10,0,0" />
                        </Grid>
                    </Border>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lessons}" Spacing="12">
                        <BindableLayout.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="20">
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenLessonCommand}" CommandParameter="{Binding .}" /></Border.GestureRecognizers>
                                <Grid ColumnDefinitions="68,*,Auto" ColumnSpacing="16">
                                    <Border BackgroundColor="#22282F" StrokeThickness="0" StrokeShape="RoundRectangle 18" HeightRequest="64" WidthRequest="64">
                                        <VerticalStackLayout Spacing="-4" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label Text="{Binding Number}" TextColor="White" FontSize="19" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                            <BoxView HeightRequest="2" WidthRequest="22" Color="#F0522D" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                        <Label Text="{Binding Title}" TextColor="#F3F4F5" FontSize="19" FontAttributes="Bold" />
                                        <Label Text="{Binding Meta}" TextColor="#AEB6BF" FontSize="12" />
                                        <Label Text="{Binding ActionLabel}" TextColor="#F0522D" FontSize="13" FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,6" VerticalOptions="Center">
                                        <Label Text="{Binding Duration}" TextColor="#BFC5CB" FontAttributes="Bold" FontSize="12" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate></BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    </VerticalStackLayout>
                    <Grid Grid.Column="1">
                        <Image x:Name="RaviCourse" Aspect="AspectFill"><Image.GestureRecognizers><TapGestureRecognizer Tapped="RaviTapped" /></Image.GestureRecognizers></Image>
                        <BoxView Color="#33090D12" />
                        <Border BackgroundColor="#B5262C33" Stroke="#70FFFFFF" StrokeThickness="1" StrokeShape="RoundRectangle 25" Padding="20,14" HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,0,100">
                            <VerticalStackLayout Spacing="3"><Label Text="NEXT MISSION" TextColor="#F0522D" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.4" /><Label Text="Pick a lesson to begin." TextColor="#F3F4F5" FontSize="15" FontAttributes="Bold" /></VerticalStackLayout>
                        </Border>
                    </Grid>
                    </Grid>
                </Grid>

                <!-- Learning -->
                <Grid x:Name="LearningStage" IsVisible="{Binding IsLearning}" Margin="36,18,36,50" MaximumWidthRequest="1180" HorizontalOptions="Fill">
                <Grid ColumnDefinitions="1.45*,0.55*" ColumnSpacing="24">
                <VerticalStackLayout x:Name="LearningContent" Spacing="17">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout><Label Text="{Binding StepEyebrow}" Style="{StaticResource SectionLabel}" /><Label Text="{Binding ProgressLabel}" TextColor="#AEB5BC" FontSize="12" /></VerticalStackLayout>
                        <Label Grid.Column="1" Text="LESSON IN PROGRESS" TextColor="#D4612D" FontSize="10" CharacterSpacing="1.2" FontAttributes="Bold" />
                    </Grid>
                    <ProgressBar Progress="{Binding LessonProgress}" ProgressColor="#F0522D" BackgroundColor="#C9CDD0" HeightRequest="8" />
                    <Border BackgroundColor="#C91E242B" Stroke="#70FFFFFF" StrokeThickness="1" StrokeShape="RoundRectangle 30" Padding="28,20">
                    <Grid>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                            <Label Text="{Binding StepTitle}" TextColor="#F3F4F5" FontSize="34" FontAttributes="Bold" />
                            <Border BackgroundColor="#CFFFFFFF" Stroke="#70FFFFFF" StrokeShape="RoundRectangle 20" Padding="14,10">
                                <Label Text="{Binding RaviTip}" FlowDirection="RightToLeft" TextColor="#424A52" FontSize="14" HorizontalTextAlignment="End" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                    </Border>

                    <!-- Proper vocabulary list -->
                    <VerticalStackLayout IsVisible="{Binding IsVocabularyStep}" Spacing="12">
                        <Label Text="Tap the speaker to hear each word." TextColor="#AEB6BF" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding VocabularyItems}" Spacing="10">
                            <BindableLayout.ItemTemplate><DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="16">
                                    <Grid ColumnDefinitions="42,1.3*,*,52" ColumnSpacing="12">
                                        <Border BackgroundColor="#E7EEF8" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="40" WidthRequest="40">
                                            <Label Text="{Binding Number}" TextColor="#173A69" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Button Text="{Binding English}" Clicked="SpeakLineClicked" BackgroundColor="Transparent" TextColor="#F3F4F5" FontSize="19" FontAttributes="Bold" Padding="0" HorizontalOptions="Start" />
                                            <HorizontalStackLayout Spacing="7">
                                                <Label Text="{Binding Phonetic}" TextColor="#AEB6BF" FontSize="11" />
                                                <Label Text="{Binding Pronunciation}" TextColor="#E65F2B" FontSize="11" FontAttributes="Bold" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding Persian}" FlowDirection="RightToLeft" TextColor="#078F91" FontSize="18" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                        <Button Grid.Column="3" Text="Listen" Clicked="SpeakWordClicked" BackgroundColor="#ECF6F5" TextColor="#0E7C7B" FontSize="10" FontAttributes="Bold" CornerRadius="10" HeightRequest="44" WidthRequest="52" Padding="4" />
                                    </Grid>
                                </Border>
                            </DataTemplate></BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Pronunciation phrases: English and Persian are always visible. -->
                    <VerticalStackLayout IsVisible="{Binding IsPhraseStep}" Spacing="12">
                        <Label Text="Tap an English sentence to hear it, then repeat it aloud." TextColor="#AEB6BF" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding LessonLines}" Spacing="10">
                            <BindableLayout.ItemTemplate><DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="16">
                                    <Grid ColumnDefinitions="42,*,*" ColumnSpacing="14">
                                        <Border BackgroundColor="#E7EEF8" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="40" WidthRequest="40">
                                            <Label Text="{Binding Number}" TextColor="#173A69" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        </Border>
                                        <Button Grid.Column="1" Text="{Binding English}" Clicked="SpeakLineClicked" BackgroundColor="Transparent" TextColor="#F3F4F5" FontSize="18" FontAttributes="Bold" Padding="0" HorizontalOptions="Start" />
                                        <Label Grid.Column="2" Text="{Binding Persian}" FlowDirection="RightToLeft" TextColor="#078F91" FontSize="17" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate></BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Storybook page: one continuous story with its translation opposite. -->
                    <VerticalStackLayout IsVisible="{Binding IsStoryStep}" Spacing="12">
                        <Image Source="{Binding StoryOpeningImage}" IsVisible="{Binding IsLessonOneStory}" HeightRequest="310" Aspect="AspectFill" />
                        <Border Style="{StaticResource Card}" Padding="24">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="28">
                                <VerticalStackLayout Spacing="10">
                                    <Label Text="ENGLISH · TAP TO LISTEN" Style="{StaticResource SectionLabel}" />
                                    <Label Text="{Binding StepContent}" TextColor="#E6E9EC" FontSize="18" LineHeight="1.55">
                                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="StoryTapped" /></Label.GestureRecognizers>
                                    </Label>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="10">
                                    <Label Text="ترجمه فارسی" FlowDirection="RightToLeft" TextColor="#E65F2B" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                    <Label Text="{Binding StoryTranslation}" FlowDirection="RightToLeft" TextColor="#087F83" FontSize="18" LineHeight="1.55" HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                        <Image Source="{Binding StoryEndingImage}" IsVisible="{Binding IsLessonOneStory}" HeightRequest="280" Aspect="AspectFill" />
                    </VerticalStackLayout>

                    <!-- Story, grammar, listening, dictation and writing -->
                    <VerticalStackLayout IsVisible="{Binding IsRegularStep}" Spacing="12">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="16">
                                <Label Text="{Binding StepContent}" TextColor="#E6E9EC" FontSize="20" LineHeight="1.55" />
                                <Button Text="Listen in English" IsVisible="{Binding CanSpeakContent}" Clicked="SpeakClicked" Style="{StaticResource Secondary}" />
                                <Button Text="{Binding StepTranslation}" IsVisible="{Binding HasTranslation}" Command="{Binding ToggleTranslationCommand}" BackgroundColor="Transparent" TextColor="#C74F25" FontAttributes="Bold" FontSize="16" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <Border x:Name="FeedbackCard" Style="{StaticResource Card}" IsVisible="{Binding ShowExercise}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,70">
                                <Label Text="تمرین با راوی" FlowDirection="RightToLeft" TextColor="#078F91" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                <Image Grid.Column="1" Source="ravi_ui.png" HeightRequest="76" Aspect="AspectFit" />
                            </Grid>
                            <Label Text="{Binding AnswerPrompt}" TextColor="#BFC5CB" FontSize="15" />
                            <Entry Text="{Binding Answer}" Placeholder="پاسخ را اینجا بنویس…" BackgroundColor="#F3F6FA" TextColor="#F3F4F5" HeightRequest="54" />
                            <Button Text="بررسی پاسخ" Command="{Binding CheckCommand}" Style="{StaticResource Secondary}" />
                            <Label Text="{Binding Feedback}" IsVisible="{Binding HasFeedback}" TextColor="#087F83" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Button Text="{Binding NextLabel}" Command="{Binding NextCommand}" Style="{StaticResource Primary}" />
