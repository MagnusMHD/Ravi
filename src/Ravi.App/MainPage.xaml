                    <BoxView Color="#26090D12" />
                    <Border x:Name="RaviSpeakingBadge" BackgroundColor="#252B32" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="14,8" HorizontalOptions="Center" VerticalOptions="Center" Opacity="0"><Label Text="RAVI IS SPEAKING" TextColor="White" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" /></Border>
                    <Border BackgroundColor="#B5262C33" Stroke="#70FFFFFF" StrokeThickness="1" StrokeShape="RoundRectangle 25" Padding="18,13" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,0,36">
                        <VerticalStackLayout Spacing="3"><Label Text="RAVI GUIDE" TextColor="#F0522D" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.4" /><Label Text="One clear step at a time." TextColor="#F3F4F5" FontSize="14" FontAttributes="Bold" /></VerticalStackLayout>
                    </Border>
                </Grid>
                </Grid>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
