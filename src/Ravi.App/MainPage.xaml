<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ravi.App.MainPage"
             BackgroundColor="#F3F6FA"
             Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="#DCE5EF" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 20" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Shadow">
                <Shadow Brush="#17345F" Opacity="0.10" Radius="16" Offset="0,6" />
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#173A69" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HeightRequest" Value="58" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Shadow">
                <Shadow Brush="#10294C" Opacity="0.24" Radius="10" Offset="0,5" />
            </Setter>
        </Style>
        <Style x:Key="Secondary" TargetType="Button">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="TextColor" Value="#173A69" />
            <Setter Property="BorderColor" Value="#C9D7E7" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HeightRequest" Value="54" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="Label">
            <Setter Property="TextColor" Value="#078F91" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="1.6" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <Grid Padding="20,12" BackgroundColor="#102D55" ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
            <Button Text="‹" Command="{Binding BackCommand}" IsVisible="{Binding ShowBack}"
                    BackgroundColor="Transparent" TextColor="White" FontSize="29" Padding="0" />
            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="10">
                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="3" HeightRequest="42" WidthRequest="42">
                    <Image Source="ravi_logo.png" Aspect="AspectFit" />
                </Border>
                <VerticalStackLayout Spacing="-2" VerticalOptions="Center">
                    <Label Text="RAVI" TextColor="White" FontSize="20" FontAttributes="Bold" CharacterSpacing="2" />
                    <Label Text="ENGLISH ADVENTURE" TextColor="#65D5D1" FontSize="8" CharacterSpacing="1.2" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
            <Border Grid.Column="2" BackgroundColor="#23436F" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="11,7">
                <Label Text="{Binding StudentBadge}" TextColor="White" FontAttributes="Bold" />
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,26,24,52" Spacing="20" MaximumWidthRequest="760" HorizontalOptions="Center">

                <!-- Start -->
                <VerticalStackLayout IsVisible="{Binding IsLogin}" Spacing="16" HorizontalOptions="Center" MaximumWidthRequest="520">
                    <Image x:Name="RaviMascot" Source="ravi_guide_v2.png" HeightRequest="370" Aspect="AspectFit" />
                    <Label Text="Learn English with Ravi" TextColor="#102D55" FontSize="34" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Label Text="واژه‌ها، داستان‌ها و تمرین‌های انگلیسی با راهنمایی راوی" FlowDirection="RightToLeft" TextColor="#607086" FontSize="17" HorizontalTextAlignment="Center" />
                    <Button Text="شروع یادگیری  →" Command="{Binding SelectRoleCommand}" CommandParameter="Student" Style="{StaticResource Primary}" />
                </VerticalStackLayout>

                <!-- Profile -->
                <VerticalStackLayout IsVisible="{Binding IsProfile}" Spacing="18">
                    <Grid ColumnDefinitions="*,135">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="6">
                            <Label Text="YOUR PROFILE" Style="{StaticResource SectionLabel}" />
                            <Label Text="Let Ravi get to know you" TextColor="#102D55" FontSize="29" FontAttributes="Bold" />
                            <Label Text="Your details make every story and exercise personal." TextColor="#607086" FontSize="15" />
                        </VerticalStackLayout>
                        <Image x:Name="RaviProfile" Grid.Column="1" Source="ravi_guide_v2.png" HeightRequest="145" Aspect="AspectFit">
                            <Image.GestureRecognizers><TapGestureRecognizer Tapped="RaviTapped" /></Image.GestureRecognizers>
                        </Image>
                    </Grid>
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="13">
                            <Label Text="What is your name?" TextColor="#102D55" FontAttributes="Bold" />
                            <Entry Text="{Binding StudentName}" Placeholder="Your first name or nickname" BackgroundColor="#F4F7FA" TextColor="#102D55" HeightRequest="54" />
                            <Label Text="How old are you?" TextColor="#102D55" FontAttributes="Bold" />
                            <Entry Text="{Binding AgeText}" Placeholder="For example: 13" Keyboard="Numeric" MaxLength="2" BackgroundColor="#F4F7FA" TextColor="#102D55" HeightRequest="54" />
                            <Label Text="Choose one" TextColor="#102D55" FontAttributes="Bold" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Text="Girl" Command="{Binding SelectGenderCommand}" CommandParameter="Girl" BackgroundColor="{Binding GirlButtonColor}" TextColor="{Binding GirlTextColor}" BorderColor="#C9D7E7" BorderWidth="1" CornerRadius="14" HeightRequest="54" />
                                <Button Grid.Column="1" Text="Boy" Command="{Binding SelectGenderCommand}" CommandParameter="Boy" BackgroundColor="{Binding BoyButtonColor}" TextColor="{Binding BoyTextColor}" BorderColor="#C9D7E7" BorderWidth="1" CornerRadius="14" HeightRequest="54" />
                            </Grid>
                            <Label Text="{Binding ProfileError}" IsVisible="{Binding HasProfileError}" TextColor="#C34040" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                    <Button Text="Start my adventure  →" Command="{Binding CreateProfileCommand}" Style="{StaticResource Primary}" />
                </VerticalStackLayout>

                <!-- Grades -->
                <VerticalStackLayout IsVisible="{Binding IsGrades}" Spacing="18">
                    <Border BackgroundColor="#102D55" StrokeThickness="0" StrokeShape="RoundRectangle 26" Padding="24,18">
                        <Grid ColumnDefinitions="*,150">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="7">
                                <Label Text="CHOOSE YOUR PATH" TextColor="#65D5D1" FontSize="11" FontAttributes="Bold" CharacterSpacing="1.5" />
                                <Label Text="Which grade are you in?" TextColor="White" FontSize="30" FontAttributes="Bold" />
                                <Label Text="پایه خود را انتخاب کن تا راوی مسیر مناسب را باز کند." FlowDirection="RightToLeft" TextColor="#DCE8F7" FontSize="16" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                            <Image Grid.Column="1" Source="ravi_guide_v2.png" HeightRequest="160" Aspect="AspectFit" />
                        </Grid>
                    </Border>
                    <FlexLayout BindableLayout.ItemsSource="{Binding Grades}" Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Start">
                        <BindableLayout.ItemTemplate><DataTemplate>
                            <Border BackgroundColor="{Binding Tint}" Stroke="{Binding Accent}" StrokeThickness="1" StrokeShape="RoundRectangle 22" Padding="18" WidthRequest="225" Margin="0,7">
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectGradeCommand}" CommandParameter="{Binding Number}" /></Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="9">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Icon}" FontSize="31" />
                                        <Label Grid.Column="1" Text="{Binding PersianName}" FlowDirection="RightToLeft" TextColor="{Binding Accent}" FontSize="16" FontAttributes="Bold" />
                                    </Grid>
                                    <Label Text="{Binding Number, StringFormat='Grade {0}'}" TextColor="#102D55" FontSize="24" FontAttributes="Bold" />
                                    <Label Text="{Binding Subtitle}" TextColor="#607086" FontSize="13" />
                                    <Label Text="Choose  →" TextColor="{Binding Accent}" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate></BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- Lessons -->
                <VerticalStackLayout IsVisible="{Binding IsLessons}" Spacing="16">
                    <Grid ColumnDefinitions="*,140">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="YOUR COURSE" Style="{StaticResource SectionLabel}" />
                            <Label Text="{Binding WelcomeTitle}" TextColor="#102D55" FontSize="31" FontAttributes="Bold" />
                            <Label Text="{Binding GradeTitle}" TextColor="#078F91" FontAttributes="Bold" />
                            <Label Text="{Binding WelcomeSubtitle}" TextColor="#607086" />
                        </VerticalStackLayout>
                        <Image x:Name="RaviCourse" Grid.Column="1" Source="ravi_guide_v2.png" HeightRequest="150" Aspect="AspectFit">
                            <Image.GestureRecognizers><TapGestureRecognizer Tapped="RaviTapped" /></Image.GestureRecognizers>
                        </Image>
                    </Grid>
                    <Border Style="{StaticResource Card}" BackgroundColor="#102D55" StrokeThickness="0">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="YOUR ADVENTURE MAP" TextColor="#65D5D1" FontSize="11" FontAttributes="Bold" CharacterSpacing="1.4" />
                                <Label Text="{Binding CourseProgressLabel}" TextColor="White" FontSize="21" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="🦊 ✦" TextColor="#F6B866" FontSize="24" VerticalOptions="Center" />
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Progress="0" ProgressColor="#F37A3F" BackgroundColor="#2B4770" HeightRequest="8" Margin="0,10,0,0" />
                        </Grid>
                    </Border>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lessons}" Spacing="12">
                        <BindableLayout.ItemTemplate><DataTemplate>
                            <Border BackgroundColor="{Binding Tint}" Stroke="{Binding Accent}" StrokeThickness="1" StrokeShape="RoundRectangle 22" Padding="18">
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenLessonCommand}" CommandParameter="{Binding .}" /></Border.GestureRecognizers>
                                <Grid ColumnDefinitions="68,*,Auto" ColumnSpacing="16">
                                    <Border BackgroundColor="White" Stroke="{Binding Accent}" StrokeShape="RoundRectangle 17" HeightRequest="64" WidthRequest="64">
                                        <VerticalStackLayout Spacing="-4" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label Text="{Binding Icon}" FontSize="24" HorizontalTextAlignment="Center" />
                                            <Label Text="{Binding Number}" TextColor="{Binding Accent}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                        <Label Text="{Binding Title}" TextColor="#102D55" FontSize="19" FontAttributes="Bold" />
                                        <Label Text="{Binding Meta}" TextColor="#607086" FontSize="12" />
                                        <Label Text="{Binding ActionLabel}" TextColor="{Binding Accent}" FontSize="13" FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,6" VerticalOptions="Center">
                                        <Label Text="{Binding Duration}" TextColor="{Binding Accent}" FontAttributes="Bold" FontSize="12" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate></BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Learning -->
                <VerticalStackLayout IsVisible="{Binding IsLearning}" Spacing="17">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout><Label Text="{Binding StepEyebrow}" Style="{StaticResource SectionLabel}" /><Label Text="{Binding ProgressLabel}" TextColor="#758197" FontSize="12" /></VerticalStackLayout>
                        <Label Grid.Column="1" Text="+10 XP" TextColor="#E65F2B" FontAttributes="Bold" />
                    </Grid>
                    <ProgressBar Progress="{Binding LessonProgress}" ProgressColor="#078F91" BackgroundColor="#DCE6EA" HeightRequest="8" />
                    <Grid ColumnDefinitions="*,140">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                            <Label Text="{Binding StepTitle}" TextColor="#102D55" FontSize="30" FontAttributes="Bold" />
                            <Border BackgroundColor="#FFF4EA" Stroke="#F5C6A7" StrokeShape="RoundRectangle 14" Padding="12,8">
                                <Label Text="{Binding RaviTip}" FlowDirection="RightToLeft" TextColor="#9A4925" FontSize="14" HorizontalTextAlignment="End" />
                            </Border>
                        </VerticalStackLayout>
                        <Image x:Name="RaviLesson" Grid.Column="1" Source="ravi_guide_v2.png" HeightRequest="150" Aspect="AspectFit">
                            <Image.GestureRecognizers><TapGestureRecognizer Tapped="RaviTapped" /></Image.GestureRecognizers>
                        </Image>
                    </Grid>

                    <!-- Proper vocabulary list -->
                    <VerticalStackLayout IsVisible="{Binding IsVocabularyStep}" Spacing="12">
                        <Label Text="Tap the speaker to hear each word." TextColor="#607086" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding VocabularyItems}" Spacing="10">
                            <BindableLayout.ItemTemplate><DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="16">
                                    <Grid ColumnDefinitions="42,1.3*,*,52" ColumnSpacing="12">
                                        <Border BackgroundColor="#E7EEF8" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="40" WidthRequest="40">
                                            <Label Text="{Binding Number}" TextColor="#173A69" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Button Text="{Binding English}" Clicked="SpeakLineClicked" BackgroundColor="Transparent" TextColor="#102D55" FontSize="19" FontAttributes="Bold" Padding="0" HorizontalOptions="Start" />
                                            <HorizontalStackLayout Spacing="7">
                                                <Label Text="{Binding Phonetic}" TextColor="#607086" FontSize="11" />
                                                <Label Text="{Binding Pronunciation}" TextColor="#E65F2B" FontSize="11" FontAttributes="Bold" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding Persian}" FlowDirection="RightToLeft" TextColor="#078F91" FontSize="18" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                        <Button Grid.Column="3" Text="🔊" Clicked="SpeakWordClicked" BackgroundColor="#E7F7F5" TextColor="#087F83" CornerRadius="12" HeightRequest="44" WidthRequest="48" Padding="0" />
                                    </Grid>
                                </Border>
                            </DataTemplate></BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Pronunciation phrases: English and Persian are always visible. -->
                    <VerticalStackLayout IsVisible="{Binding IsPhraseStep}" Spacing="12">
                        <Label Text="Tap an English sentence to hear it, then repeat it aloud." TextColor="#607086" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding LessonLines}" Spacing="10">
                            <BindableLayout.ItemTemplate><DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="16">
                                    <Grid ColumnDefinitions="42,*,*" ColumnSpacing="14">
                                        <Border BackgroundColor="#E7EEF8" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="40" WidthRequest="40">
                                            <Label Text="{Binding Number}" TextColor="#173A69" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        </Border>
                                        <Button Grid.Column="1" Text="{Binding English}" Clicked="SpeakLineClicked" BackgroundColor="Transparent" TextColor="#102D55" FontSize="18" FontAttributes="Bold" Padding="0" HorizontalOptions="Start" />
                                        <Label Grid.Column="2" Text="{Binding Persian}" FlowDirection="RightToLeft" TextColor="#078F91" FontSize="17" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate></BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Storybook page: one continuous story with its translation opposite. -->
                    <VerticalStackLayout IsVisible="{Binding IsStoryStep}" Spacing="12">
                        <Image Source="{Binding StoryOpeningImage}" IsVisible="{Binding IsLessonOneStory}" HeightRequest="310" Aspect="AspectFill" />
                        <Border Style="{StaticResource Card}" Padding="24">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="28">
                                <VerticalStackLayout Spacing="10">
                                    <Label Text="ENGLISH · TAP TO LISTEN" Style="{StaticResource SectionLabel}" />
                                    <Label Text="{Binding StepContent}" TextColor="#203858" FontSize="18" LineHeight="1.55">
                                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="StoryTapped" /></Label.GestureRecognizers>
                                    </Label>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="10">
                                    <Label Text="ترجمه فارسی" FlowDirection="RightToLeft" TextColor="#E65F2B" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                    <Label Text="{Binding StoryTranslation}" FlowDirection="RightToLeft" TextColor="#087F83" FontSize="18" LineHeight="1.55" HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                        <Image Source="{Binding StoryEndingImage}" IsVisible="{Binding IsLessonOneStory}" HeightRequest="280" Aspect="AspectFill" />
                    </VerticalStackLayout>

                    <!-- Story, grammar, listening, dictation and writing -->
                    <VerticalStackLayout IsVisible="{Binding IsRegularStep}" Spacing="12">
                        <Border Style="{StaticResource Card}" BackgroundColor="#EAF1F9" Stroke="#C4D5E8">
                            <VerticalStackLayout Spacing="16">
                                <Label Text="{Binding StepContent}" TextColor="#203858" FontSize="20" LineHeight="1.55" />
                                <Button Text="🔊   Listen in English" IsVisible="{Binding CanSpeakContent}" Clicked="SpeakClicked" Style="{StaticResource Secondary}" />
                                <Button Text="{Binding StepTranslation}" IsVisible="{Binding HasTranslation}" Command="{Binding ToggleTranslationCommand}" BackgroundColor="Transparent" TextColor="#C74F25" FontAttributes="Bold" FontSize="16" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <Border Style="{StaticResource Card}" IsVisible="{Binding ShowExercise}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,70">
                                <Label Text="تمرین با راوی" FlowDirection="RightToLeft" TextColor="#078F91" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                <Image Grid.Column="1" Source="ravi_guide_v2.png" HeightRequest="76" Aspect="AspectFit" />
                            </Grid>
                            <Label Text="{Binding AnswerPrompt}" TextColor="#52647B" FontSize="15" />
                            <Entry Text="{Binding Answer}" Placeholder="پاسخ را اینجا بنویس…" BackgroundColor="#F3F6FA" TextColor="#102D55" HeightRequest="54" />
                            <Button Text="بررسی پاسخ" Command="{Binding CheckCommand}" Style="{StaticResource Secondary}" />
                            <Label Text="{Binding Feedback}" IsVisible="{Binding HasFeedback}" TextColor="#087F83" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Button Text="{Binding NextLabel}" Command="{Binding NextCommand}" Style="{StaticResource Primary}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
