<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ravi.App.MainPage"
             BackgroundColor="#F8F4EA"
             Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#FFFFFF" />
            <Setter Property="Stroke" Value="#E8E1D3" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 24" />
            <Setter Property="Padding" Value="22" />
        </Style>
        <Style x:Key="Eyebrow" TargetType="Label">
            <Setter Property="TextColor" Value="#0EAEB8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="1.5" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#102A56" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="HeightRequest" Value="58" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <Grid BackgroundColor="#102A56" Padding="22,16" ColumnDefinitions="*,Auto">
            <HorizontalStackLayout Spacing="10">
                <Border BackgroundColor="#FF7A18" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="9,5">
                    <Label Text="R" TextColor="White" FontSize="20" FontAttributes="Bold" />
                </Border>
                <VerticalStackLayout Spacing="-2" VerticalOptions="Center">
                    <Label Text="RAVI" TextColor="White" FontSize="20" FontAttributes="Bold" CharacterSpacing="2" />
                    <Label Text="ENGLISH ADVENTURE" TextColor="#70D6DC" FontSize="9" CharacterSpacing="1.2" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
            <Border Grid.Column="1" BackgroundColor="#203C69" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="12,7">
                <Label Text="🔥 6" TextColor="White" FontAttributes="Bold" />
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="22,24,22,36" Spacing="18">
                <Grid IsVisible="{Binding IsHomeVisible}" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="18">
                    <Grid ColumnDefinitions="*,92">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                            <Label Text="{Binding Greeting}" FlowDirection="RightToLeft" TextColor="#102A56" FontSize="28" FontAttributes="Bold" />
                            <Label Text="Bereit für das nächste Kapitel?" TextColor="#657086" FontSize="15" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" HeightRequest="82" WidthRequest="82" StrokeThickness="0" StrokeShape="RoundRectangle 22" BackgroundColor="#FFE1C7">
                            <Image Source="ravi_logo.png" Aspect="AspectFill" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" BackgroundColor="#102A56" StrokeThickness="0">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="HEUTIGE MISSION" Style="{StaticResource Eyebrow}" />
                                <Label Grid.Column="1" Text="12 MIN" TextColor="#A9B8D0" FontSize="12" FontAttributes="Bold" />
                            </Grid>
                            <Label Text="{Binding MissionTitle}" TextColor="White" FontSize="27" FontAttributes="Bold" />
                            <Label Text="{Binding MissionSubtitle}" FlowDirection="RightToLeft" TextColor="#D9E2F0" FontSize="15" />
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="9">
                                <Label Text="WORDS" TextColor="#FFB06E" FontSize="11" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="• STORY" TextColor="#70D6DC" FontSize="11" FontAttributes="Bold" />
                                <Label Grid.Column="2" Text="• LISTEN" TextColor="#FFFFFF" FontSize="11" FontAttributes="Bold" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="11">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Deine Woche" TextColor="#102A56" FontSize="17" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="Klasse 7" TextColor="#0A8F98" FontAttributes="Bold" />
                            </Grid>
                            <ProgressBar Progress="{Binding Progress}" ProgressColor="#FF7A18" BackgroundColor="#EFE9DF" HeightRequest="8" />
                            <Label Text="{Binding ProgressText}" TextColor="#657086" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>

                    <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Style="{StaticResource Card}" Padding="16">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="12" TextColor="#FF7A18" FontSize="25" FontAttributes="Bold" />
                                <Label Text="gelernte Wörter" TextColor="#657086" FontSize="12" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="2" TextColor="#0EAEB8" FontSize="25" FontAttributes="Bold" />
                                <Label Text="Story-Hinweise" TextColor="#657086" FontSize="12" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </Grid>

                <Border IsVisible="{Binding IsMissionOpen}" Style="{StaticResource Card}" Padding="24,30">
                    <VerticalStackLayout Spacing="20">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding StepEyebrow}" Style="{StaticResource Eyebrow}" />
                            <Label Grid.Column="1" Text="RAVI" TextColor="#FF7A18" FontAttributes="Bold" />
                        </Grid>
                        <ProgressBar Progress="{Binding Progress}" ProgressColor="#0EAEB8" BackgroundColor="#E7EFEF" HeightRequest="8" />
                        <Label Text="{Binding StepTitle}" TextColor="#102A56" FontSize="29" FontAttributes="Bold" />
                        <Label Text="{Binding PersianHint}" FlowDirection="RightToLeft" HorizontalTextAlignment="End" TextColor="#0A8F98" FontSize="17" />
                        <Border BackgroundColor="#FFF5E9" Stroke="#FFD4AD" StrokeShape="RoundRectangle 18" Padding="20" MinimumHeightRequest="128">
                            <Label Text="{Binding StepContent}" TextColor="#283A58" FontSize="18" LineHeight="1.4" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                        </Border>
                        <Label Text="Fehler sind Hinweise – Ravi hilft dir weiter." TextColor="#798397" FontSize="12" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="{Binding PrimaryAction}" Command="{Binding PrimaryCommand}" Style="{StaticResource PrimaryButton}" />
                <Label Text="Demo-Inhalte • Schulbuch-Zuordnung folgt" TextColor="#9A948A" FontSize="10" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
